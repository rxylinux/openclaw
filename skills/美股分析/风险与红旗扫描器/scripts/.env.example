# 风险扫描 API 配置示例

# SEC API Key (用于获取Form 4、13F文件)
# 获取地址: https://www.sec.gov/edgar/sec-api-documentation
SEC_API_KEY=your_key_here

# Bloomberg API Key (可选，用于获取监管新闻)
# 获取地址: https://www.bloomberg.com/professional/api
BLOOMBERG_API_KEY=your_key_here

# Yahoo Finance API (用于获取做空数据)
# 获取地址: https://www.yahoofinance.com/api
YAHOO_FINANCE_KEY=your_key_here

# News API (可选，用于获取监管新闻)
# 获取地址: https://newsapi.org
NEWS_API_KEY=your_key_here
