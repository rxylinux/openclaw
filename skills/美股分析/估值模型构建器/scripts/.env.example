# 估值模型构建 API 配置示例

# Alpha Vantage API Key (可选，用于获取财务数据)
# 获取地址: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here

# Financial Modeling Prep API Key (可选，用于获取财报和估值数据)
# 获取地址: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_key_here

# Federal Reserve API (可选，用于获取利率数据)
# 获取地址: https://www.federalreserve.gov/
FED_API_KEY=your_key_here
