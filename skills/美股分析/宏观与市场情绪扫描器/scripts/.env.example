# 宏观分析 API 配置示例

# FRED API Key (用于获取经济数据)
# 获取地址: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_key_here

# CME API Key (用于获取FedWatch数据)
# 获取地址: https://www.cmegroup.com/confluence/display/EPICSANDBOX/CME+API+Gateway
CME_API_KEY=your_key_here

# Bloomberg API Key (用于获取市场数据)
# 获取地址: https://www.bloomberg.com/professional/api
BLOOMBERG_API_KEY=your_key_here

# Reuters API Key (用于获取新闻)
# 获取地址: https://developers.refinitiv.com/
REUTERS_API_KEY=your_key_here

# Financial Modeling Prep API Key (可选)
# 获取地址: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_key_here

# Alpha Vantage API Key (可选)
# 获取地址: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here
