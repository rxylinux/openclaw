# 股息分析 API 配置示例

# Alpha Vantage API Key (可选，用于获取股息数据)
# 获取地址: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here

# Financial Modeling Prep API Key (可选，用于获取股息历史)
# 获取地址: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_key_here

# Dividend.com API (可选，用于获取股息贵族数据)
# 获取地址: https://www.dividend.com/api
DIVIDEND_API_KEY=your_key_here
