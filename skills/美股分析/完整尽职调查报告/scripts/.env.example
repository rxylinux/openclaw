# 尽职调查 API 配置示例

# SEC API Key (用于获取SEC文件)
# 获取地址: https://www.sec.gov/edgar/sec-api-documentation
SEC_API_KEY=your_key_here

# Bloomberg API Key (用于获取市场数据)
# 获取地址: https://www.bloomberg.com/professional/api
BLOOMBERG_API_KEY=your_key_here

# FactSet API Key (用于获取分析师预期)
# 获取地址: https://www.factset.com/products/data/workstation
FACTSET_API_KEY=your_key_here

# Alpha Vantage API Key (用于获取基础数据)
# 获取地址: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_key_here

# Financial Modeling Prep API Key (用于获取财务数据)
# 获取地址: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_key_here

# IEX Cloud API Key (用于获取实时数据)
# 获取地址: https://iexcloud.io/pricing
IEX_API_KEY=your_key_here

# QuickFS API Key (用于获取财务数据)
# 获取地址: https://quickfs.net/
QUICKFS_API_KEY=your_key_here
